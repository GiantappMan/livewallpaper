# build outputs
target/
/src-tauri/gen/schemas

# frontend
node_modules
/src/giantapp-wallpaper-ui/dist
/src/giantapp-wallpaper-ui/.env*.local
# bundled player binaries (downloaded at build time, see docs/1.开发.md)
/src-tauri/assets/players/mpv/*
!/src-tauri/assets/players/mpv/.gitkeep
/src-tauri/assets/players/libmpv/*
!/src-tauri/assets/players/libmpv/.gitkeep

# secrets / local credentials
.env
.env.*
!.env.example
*.pem
*.key

# logs / local
*.log
.DS_Store

# 本地临时产物
.tmp-shots/
.tmp-chrome-profile/

# AI 工具本地状态（mimosa 扫描状态、会话计划、本机插件路径）
.mimosa/
.zcode/plans/
.zcode/tmp/
.zcode/screenshots/
.zcode/workflow-drafts/
.zcode/workflow-runs/
.video_agent/

# CF 发布（scripts/publish.ts）：wrangler 本地状态与脚本生成的临时配置/产物
.wrangler/
scripts/cloudflare/wrangler.generated.toml
build/publish/

