; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

#define MyAppVersion GetVersionNumbersString(".\publish\LiveWallpaper3.exe")
; SemVer = 完整语义化版本（含 -alpha.x 预发布后缀），由 compile.ps1 经 /DSemVer
; 传入；exe 的 Windows 版本号只能纯数字（3.1.1-alpha.1 会被拍平成 3.1.1.1），
; 文件名/显示名用它就会丢预览身份，故只在未传时回退数字版本。
#ifndef SemVer
  #define SemVer MyAppVersion
#endif
#define ProductName "LiveWallpaper"
#define ProductVersionName "LiveWallpaper3"
#define MyAppPublisher "Giantapp Studio"
#define MyAppURL "https://www.giantapp.cn"
#define MyAppExeName "LiveWallpaper3.exe"
#define ProductNameEn="Live Wallpaper 3"
#define ProductNameZh="巨应壁纸3"
#define OutputDir=".\dist"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{59D77B88-6E82-422B-897B-D4B522C491B7}
AppName={cm:AppName}
AppVersion={#MyAppVersion}
AppVerName={#ProductName} v{#SemVer}
VersionInfoVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#ProductVersionName}
DisableProgramGroupPage=yes
; Remove the following line to run in administrative install mode (install for all users.)
PrivilegesRequired=lowest
OutputDir={#OutputDir}
OutputBaseFilename={#ProductName}_Installer_v{#SemVer}
VersionInfoDescription={#ProductName} Installer v{#MyAppVersion}
VersionInfoProductName={#ProductName} Installer v{#MyAppVersion}
SetupIconFile=..\giantapp-wallpaper-client\Client\Assets\Img\logo.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern
UninstallDisplayIcon={app}\{#MyAppExeName}

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "ChineseSimplified.isl"

[CustomMessages]
english.AppName={#ProductNameEn}
chinesesimplified.AppName={#ProductNameZh}

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}";

[Files]
Source: "publish\{#MyAppExeName}"; DestDir: "{app}"; Flags: ignoreversion
Source: "publish\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{autoprograms}\{cm:AppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{cm:AppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(ProductName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[UninstallRun]
Filename: "{sys}\taskkill.exe"; Parameters: "/f /t /im {#MyAppExeName}"; RunOnceId: "killprocss";
; 主程序派生的 mpv.exe 是独立子进程，主程序被杀后会孤儿化继续锁安装目录文件
Filename: "{sys}\taskkill.exe"; Parameters: "/f /t /im mpv.exe"; RunOnceId: "killmpv";

[Code]
// 升级前强制结束主程序与 mpv 播放器：mpv.exe 是主程序派生的独立子进程，主程序
// 退出后它会孤儿化继续锁住 Assets\Players\Mpv 下的文件；Restart Manager 关不掉
// 它（不处理 WM_ENDSESSION），曾导致升级弹"安装程序无法自动关闭所有应用程序"。
// 本事件函数在 Inno 的文件占用检查（CloseApplications）之前调用，静默安装（应用
// 内自动升级）同样生效，先杀干净则占用检查为空、弹窗不会出现。杀掉的壁纸进程
// 无需恢复：新版启动时按快照检测旧 PId 已死会自动重新拉起。
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  resultCode: Integer;
begin
  Result := '';
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /t /im {#MyAppExeName}', '', SW_HIDE, ewWaitUntilTerminated, resultCode);
  Exec(ExpandConstant('{sys}\taskkill.exe'), '/f /t /im mpv.exe', '', SW_HIDE, ewWaitUntilTerminated, resultCode);
  // 给系统留出释放文件句柄的时间
  Sleep(1000);
end;
