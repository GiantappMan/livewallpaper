<Window
    x:Class="GiantappWallpaper.CommunityNavWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CommunityNav"
    Width="56"
    Height="130"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    MouseEnter="Root_MouseEnter"
    MouseLeave="Root_MouseLeave"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    WindowStyle="None">
    <Window.Resources>
        <!--  社区快捷工具条按钮：悬停背景淡入 + 图标放大，按压加深，禁用减淡，带手型光标  -->
        <Style x:Key="NavToolButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForeground}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="hoverBG"
                                Background="{DynamicResource TitleForeground}"
                                CornerRadius="17"
                                Opacity="0" />
                            <Border
                                x:Name="pressedBG"
                                Background="{DynamicResource TitleForeground}"
                                CornerRadius="17"
                                Opacity="0" />
                            <ContentPresenter
                                x:Name="icon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <ScaleTransform x:Name="iconScale" ScaleX="1" ScaleY="1" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                            <!--  悬停：背景淡入 + 图标放大（动画过渡，反馈更明显）  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBG" Storyboard.TargetProperty="Opacity" To="0.18" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverBG" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!--  按压：再叠一层加深  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBG" Property="Opacity" Value="0.25" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <!--  展开：竖向胶囊（后退 / 前进 / 刷新），从右下角放大出现  -->
        <Border
            x:Name="ExpandedRoot"
            Margin="6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Opacity="0"
            RenderTransformOrigin="1,1"
            Background="{DynamicResource TitleBackground}"
            BorderBrush="{DynamicResource TitleForeground}"
            BorderThickness="1"
            CornerRadius="22">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ExpandScale" ScaleX="0.4" ScaleY="0.4" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="8"
                    Direction="270"
                    Opacity="0.35"
                    ShadowDepth="2" />
            </Border.Effect>
            <StackPanel Margin="0,4">
                <Button
                    x:Name="BtnBack"
                    Width="36"
                    Height="36"
                    Click="BtnBack_Click"
                    Content="&#xE72B;"
                    Style="{StaticResource NavToolButton}" />
                <Button
                    x:Name="BtnForward"
                    Width="36"
                    Height="36"
                    Click="BtnForward_Click"
                    Content="&#xE72A;"
                    Style="{StaticResource NavToolButton}" />
                <Button
                    x:Name="BtnRefresh"
                    Width="36"
                    Height="36"
                    Click="BtnRefresh_Click"
                    Content="&#xE72C;"
                    Style="{StaticResource NavToolButton}" />
            </StackPanel>
        </Border>
        <!--  折叠：单圆把手，悬停展开；非 RTL 时贴右下角  -->
        <Border
            x:Name="CollapsedRoot"
            Width="36"
            Height="36"
            Margin="0,0,10,10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{DynamicResource TitleBackground}"
            BorderBrush="{DynamicResource TitleForeground}"
            BorderThickness="1"
            CornerRadius="18"
            Cursor="Hand"
            Opacity="0.94">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Direction="270"
                    Opacity="0.3"
                    ShadowDepth="1" />
            </Border.Effect>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                FontSize="12"
                Foreground="{DynamicResource TitleForeground}"
                Text="&#xE712;" />
        </Border>
    </Grid>
</Window>
