<Window
    x:Class="GiantappWallpaper.CommunityNavWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CommunityNav"
    Width="104"
    Height="40"
    AllowsTransparency="True"
    Background="Transparent"
    Focusable="False"
    ResizeMode="NoResize"
    ShowActivated="False"
    ShowInTaskbar="False"
    WindowStyle="None">
    <Window.Resources>
        <!--  标题栏幽灵按钮：与 ShellWindow 的 NavIconButton 同规格（32×32、悬停 12% 淡入、
        圆角 4、无底无边），视觉上融入标题栏而不是一块浮着的胶囊  -->
        <Style x:Key="NavToolButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForeground}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="hoverBG"
                                Background="{DynamicResource TitleForeground}"
                                CornerRadius="4"
                                Opacity="0" />
                            <Border
                                x:Name="pressedBG"
                                Background="{DynamicResource TitleForeground}"
                                CornerRadius="4"
                                Opacity="0" />
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBG" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedBG" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!--  透明承载：三枚幽灵按钮直接落在标题栏上，四周留 4px 命中余量  -->
    <StackPanel Margin="4" Orientation="Horizontal">
        <Button
            x:Name="BtnBack"
            Click="BtnBack_Click"
            Content="&#xE72B;"
            Style="{StaticResource NavToolButton}" />
        <Button
            x:Name="BtnForward"
            Click="BtnForward_Click"
            Content="&#xE72A;"
            Style="{StaticResource NavToolButton}" />
        <Button
            x:Name="BtnRefresh"
            Click="BtnRefresh_Click"
            Content="&#xE72C;"
            Style="{StaticResource NavToolButton}" />
    </StackPanel>
</Window>
