<Window
    x:Class="GiantappWallpaper.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:lan="clr-namespace:MultiLanguageForXAML;assembly=MultiLanguageForXAML"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="800"
    MinHeight="482"
    lan:Xaml.Key="app_name"
    Icon="pack://application:,,,/LiveWallpaper3;component/Assets/Img/logo.png"
    KeyDown="Window_KeyDown"
    Style="{StaticResource GiantappWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  工具条图标按钮（Segoe Fluent Icons / MDL2 字形），悬停浮层用 TitleForeground 低透明度适配明暗主题  -->
        <Style x:Key="NavIconButton" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TitleForeground}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border
                                x:Name="hoverBG"
                                Background="{DynamicResource TitleForeground}"
                                CornerRadius="4"
                                Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverBG" Property="Opacity" Value="0.12" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
            x:Name="addressPanel"
            Margin="12,0,0,8"
            LastChildFill="True"
            Visibility="Collapsed">
            <!--  外部网页没有前端自绘标题栏，传统浏览器工具条（导航 + 地址胶囊）随地址栏一起显示  -->
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="BtnBack"
                    Click="BtnBack_Click"
                    Content="&#xE72B;"
                    IsEnabled="False"
                    Style="{StaticResource NavIconButton}" />
                <Button
                    x:Name="BtnForward"
                    Click="BtnForward_Click"
                    Content="&#xE72A;"
                    IsEnabled="False"
                    Style="{StaticResource NavIconButton}" />
                <Button
                    x:Name="BtnReload"
                    Click="BtnReload_Click"
                    Content="&#xE72C;"
                    Style="{StaticResource NavIconButton}" />
            </StackPanel>
            <StackPanel
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                WindowChrome.IsHitTestVisibleInChrome="True">
                <Button
                    x:Name="BtnMinimize"
                    Click="BtnMinimize_Click"
                    Style="{DynamicResource BtnMinimize}" />
                <Button
                    x:Name="BtnMaximize"
                    Click="BtnMaximize_Click"
                    Style="{DynamicResource BtnMaximize}" />
                <Button
                    x:Name="BtnRestore"
                    Click="BtnRestore_Click"
                    Style="{DynamicResource BtnRestore}" />
                <Button
                    x:Name="BtnClose"
                    Click="BtnClose_Click"
                    Style="{DynamicResource BtnClose}" />
            </StackPanel>
            <!--  地址胶囊：胶囊本体保留为窗口拖拽区，仅复制按钮可点  -->
            <Grid Margin="8,0,8,0" VerticalAlignment="Center">
                <Border
                    Height="30"
                    Background="{DynamicResource TitleForeground}"
                    CornerRadius="15"
                    Opacity="0.08" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        FontSize="12"
                        Opacity="0.6"
                        Text="&#xE774;" />
                    <TextBlock
                        x:Name="tbAddress"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Opacity="0.9"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        x:Name="BtnCopyAddress"
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        Margin="0,0,2,0"
                        Click="BtnCopyAddress_Click"
                        Content="&#xE8C8;"
                        Style="{StaticResource NavIconButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                </Grid>
            </Grid>
        </DockPanel>
        <Wpf:WebView2
            x:Name="webview2"
            Grid.Row="1"
            Grid.RowSpan="2"
            Visibility="Collapsed" />
        <StackPanel
            x:Name="tips"
            Grid.RowSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Stretch"
                lan:Xaml.Key="installWebview2Tips"
                FontSize="20"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontSize="20">
                <Hyperlink Click="DownloadHyperlink_Click">
                    <TextBlock lan:Xaml.Key="installNow" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
        <hc:LoadingCircle x:Name="loading" Grid.RowSpan="2" />
    </Grid>
</Window>
