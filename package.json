{
  "name": "livewallpaper-v2",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n web,client -c cyan,green \"npm:dev:web\" \"npm:dev:client\"",
    "dev:web": "cd livewallpaper-client-ui && npx nuxt dev -p 3001",
    "dev:client": "cd LiveWallpaper.Shell && dotnet watch --non-interactive --project . run",
    "dev:server": "dotnet watch --non-interactive --project LiveWallpaper.LocalServer.DevHost run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7"
  }
}
